# -----------------------------------------------------------------------------
# CommCart Environment Configuration Template
# Duplicate this file to .env.local and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Application Host URL
# AI Studio automatically injects this at runtime or use http://localhost:3000 locally
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase Configuration
# Required for database persistence, real-time messaging, and auth.
# Find these in your Supabase Project Settings -> API.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-backend-only"

# Vite client-side compatibility aliases
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Direct Postgres Database Connection (Server-only, used for running migrations)
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Meta & Instagram Graph API Configuration
# Used for listening to Instagram DM webhooks and responding with catalog items.
# Obtain from Meta for Developers (developers.facebook.com)
# -----------------------------------------------------------------------------
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
INSTAGRAM_PAGE_ID="your_instagram_page_id"
INSTAGRAM_PAGE_ACCESS_TOKEN="your_instagram_page_access_token"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
INSTAGRAM_GRAPH_API_VERSION="v21.0"

# -----------------------------------------------------------------------------
# Safaricom M-Pesa Daraja API Configuration
# Used for Lipa Na M-Pesa Online (STK Push) checkout.
# Obtain from Safaricom Developer Portal (developer.safaricom.co.ke)
# -----------------------------------------------------------------------------
# Environment: 'sandbox' for testing, 'production' for live transactions
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
# Paybill or Buy Goods Till number (e.g. 174379 for sandbox test shortcode)
MPESA_SHORTCODE="174379"
# Daraja Lipa Na M-Pesa Online passkey
MPESA_PASSKEY="your_daraja_online_passkey"
# Public HTTPS webhook URL where Safaricom posts STK Push callback confirmations
MPESA_CALLBACK_URL="https://your-domain.com/api/webhooks/mpesa/callback"
# Optional B2C / Reversal Initiator credentials
MPESA_INITIATOR_NAME="your_daraja_initiator_name"
MPESA_SECURITY_CREDENTIAL="your_daraja_security_credential"
